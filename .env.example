# Upstash Redis credentials (get these from your Upstash dashboard)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Family password for authentication
FAMILY_PASSWORD=YourFamilyPassword

# Optional: API URL for local development (not needed for production)
# REACT_APP_API_URL=http://localhost:3000/api
